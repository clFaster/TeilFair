{
  "name": "teilfair",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2+sha512.71c631e382066efc25625d5cf029075de07b61b37f6e27350fbd84b1bda5864c8c1967adc280776b45c30a715c0359a3be08fef42d5bb09e2b99029979692916",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "pnpm --filter @teilfair/web run dev",
    "mobile": "pnpm --filter @teilfair/mobile run start",
    "build:shared": "pnpm --filter @teilfair/shared run build",
    "build:web": "pnpm --filter @teilfair/web run build",
    "test": "pnpm --filter @teilfair/shared run test",
    "lint": "pnpm --filter @teilfair/web run lint",
    "build": "pnpm --filter @teilfair/shared run build && pnpm --filter @teilfair/web run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
