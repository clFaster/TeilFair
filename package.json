{
  "name": "teilfair",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "web": "pnpm --filter @teilfair/web run dev",
    "mobile": "pnpm --filter @teilfair/mobile run start",
    "build:shared": "pnpm --filter @teilfair/shared run build",
    "build:web": "pnpm --filter @teilfair/web run build",
    "test": "pnpm --filter @teilfair/shared run test",
    "build": "pnpm -r --filter ./packages/** build && pnpm --filter web build"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
