{
  "name": "teilfair",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test:stack": "node scripts/test-local-stack.mjs",
    "local:stop": "node scripts/stop-local.mjs",
    "test:local": "pnpm --filter @teilfair/web run test:local",
    "local:web": "node scripts/local-web.mjs dev",
    "local:preview": "node scripts/local-web.mjs build-preview",
    "local:check": "node scripts/check-local-environment.mjs",
    "test:local:targets": "node --test --test-isolation=none scripts/test-local-targets.mjs",
    "db:start": "node scripts/start-local-backend.mjs",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:diff": "supabase db schema declarative sync --schema public,private --no-apply",
    "db:check": "node scripts/check-db-schema.mjs",
    "web": "pnpm --filter @teilfair/web run dev",
    "mobile": "pnpm run build:shared && pnpm --filter @teilfair/mobile run start",
    "build:shared": "pnpm --filter @teilfair/shared run build",
    "build:web": "pnpm --filter @teilfair/web run build",
    "test": "pnpm --filter @teilfair/shared run test",
    "test:coverage": "pnpm --filter @teilfair/shared run test:coverage",
    "test:security:db": "node scripts/test-database-security.mjs",
    "test:security:storage": "node --test --test-isolation=none scripts/test-mobile-storage.mjs",
    "test:security:reports": "node --test --test-isolation=none scripts/test-system-reporter.mjs",
    "typecheck:shared": "pnpm --filter @teilfair/shared run typecheck",
    "lint": "pnpm --filter @teilfair/web run lint",
    "typecheck:mobile": "pnpm run build:shared && pnpm --filter @teilfair/mobile run typecheck",
    "export:mobile": "pnpm run build:shared && pnpm --filter @teilfair/mobile run export",
    "test:smoke": "pnpm --filter @teilfair/web run test:smoke",
    "build": "pnpm --filter @teilfair/shared run build && pnpm --filter @teilfair/web run build",
    "aspire:start": "node scripts/aspire.mjs start",
    "aspire:restore": "node scripts/aspire.mjs restore",
    "aspire:build": "pnpm --dir aspire-apphost run aspire:build",
    "aspire:dev": "pnpm --dir aspire-apphost run aspire:dev"
  },
  "devDependencies": {
    "@microsoft/aspire-cli": "13.6.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "supabase": "2.122.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
